extends base

block content
    .container-fluid.w-50(id="buscadorDiv")
        h3.center Buscador
        form(action="/", method="get" id="formBuscador" name="formBuscador" required).needs-validation
            .row
                .col-8
                    input(type="search" id="buscador" name="buscador" placeholder="Busca por personaje").form-control
                    .invalid-feedback Por favor no deje el campo vacio.
                .col-4
                    input(type="submit" value="Buscar")
    .container-fluid.w-75 
        table.table.table-striped(id= "resultadosBusqueda")
            thead 
            tbody
    hr
    .container-fluid.w-100
        h3.center Bienvenida
        .loader(id="loader")
            img(src="../img/spinner_2.gif" alt="Cargando..." width="500")
        .container-fluid.w-75(id="bienvenida")
            .row.row-cols-1.row-cols-md-2.row-cols-lg-4.g-4(id="contenedor")
            </div>
    //- hr
    //- .container-fluid.w-75
    //-     h3.center Favoritos
    //-     .row.row-cols-1.row-cols-md-2.row-cols-lg-4.g-4(id="favoritos")
    hr
    .container-fluid.w-75
        h3.center Favoritos group
        .list-group(id="favoritosGroup")

    hr
    .container-fluid.w-75
        h3.center Mapa
        .mapa(id="map")


    .aviso-cookies(id="avisoCookies") Este sitio usa cookies para mejorar tu experiencia. ¿Aceptas?
        button(id="btnAceptarCookies") Aceptar
        button(id="btnRechazarCookies") Rechazar

